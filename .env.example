# Arduino Serial Sensor Telemetry Microservice - Environment Configuration

# Serial Hardware Settings (use 'auto' or explicit port e.g. /dev/ttyUSB0 or COM3)
SERIAL_PORT=auto
BAUD_RATE=9600
SERIAL_TIMEOUT_SEC=1.0

# Cloud / Backend Dispatch Settings
TELEMETRY_ENDPOINT=http://127.0.0.1:8080/api/v1/telemetry
DISPATCH_TIMEOUT_SEC=5.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Offline Buffer & Store-and-Forward
OFFLINE_BUFFER_MAX_SIZE=1000
FLUSH_BATCH_SIZE=20

# Simulator Mode (Set to true to run without physical Arduino hardware)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=1.0

# Monitoring Web Server & Telemetry Dashboard
WEB_SERVER_ENABLED=true
WEB_PORT=8080
WEB_HOST=0.0.0.0

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
